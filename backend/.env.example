
NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/life-tracker
# Production example:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/life-tracker?retryWrites=true&w=majority

JWT_SECRET=your_super_strong_secret_here_change_this
JWT_EXPIRES_IN=7d

# Primary frontend origin (required for your frontend deployment).
CLIENT_URL=http://localhost:5173

# Optional additional trusted frontend origins.
# Separate multiple origins with commas.
# Do not include paths, query strings, or wildcard (*).
# Example:
# CORS_ORIGINS=https://admin.example.com,https://dashboard.example.com

# Production example:
# CLIENT_URL=https://your-frontend.vercel.app

# VAPID PUBLIC KEY
VAPID_PUBLIC_KEY= 
# VAPID PRIVATE KEY
VAPID_PRIVATE_KEY=
# VAPID CONTACT EMAIL
VAPID_SUBJECT = 